@@ -0,0 +1,55 @@
+"""Film/series sanity check on a title's English Wikipedia page (fetcher 1.6.0).
+
+DECISIONS 2026-10-03: a TV-series item whose Wikipedia page's short description names a film
+and no series is skipped, and so is a movie item whose page's short description names a series
+and no film. Wikidata's enwiki sitelink for Code Geass's series item (Q4384067) leads to the
+compilation-film article "Code Geass Lelouch of the Rebellion" ("Three-part film by Gorō
+Taniguchi"), whose plot section describes the films; the QID check passes, because the page
+does carry that item, so only the page's own description shows the mismatch.
+
+The short description is the page property ``wikibase-shortdesc``, read in the same
+``action=query`` request that resolves the page and checks its Wikidata item
+(``PlotFetcher.latest_revision``): no extra call. A page without one is not checked.
+
+The words are deliberately narrow, so a description naming both ("Film series", "Television
+film based on the series") or neither ("South Korean television drama", "Stage musical") never
+skips a title:
+
+- a film: "film(s)", "movie(s)", "telefilm";
+- a series: "series", "miniseries" / "mini-series", "serial(s)", "sitcom", "soap opera",
+  "telenovela", "TV / television show", "TV / television program(me)".
+
+``plots`` records the description on every plot file (``short_description``) and skips a
+mismatch as ``media_type_mismatch``. ``ingest kind-check`` applies the same rule to files
+fetched before 1.6.0, from a batched page-property lookup, so ``needs_fetch`` can fetch exactly
+those files again (``KIND_CHECK_FILE``).
+"""
+
+from __future__ import annotations
+
+import re
+
+FILM_WORDS = re.compile(r"\b(?:films?|movies?|telefilms?)\b", re.IGNORECASE)
+SERIES_WORDS = re.compile(
+    r"\b(?:series|mini-?series|serials?|sitcoms?|soap operas?|telenovelas?|"
+    r"(?:tv|television) (?:shows?|programmes?|programs?))\b",
+    re.IGNORECASE,
+)
+SKIP_MEDIA_TYPE_MISMATCH = "media_type_mismatch"
+KIND_CHECK_VERSION = "1.0.0"
+
+
+def media_type_mismatch(short_description: str | None, media_type: str) -> str | None:
+    """Why the page doesn't fit the item's media type, or None (it fits, or can't be told)."""
+    desc = " ".join((short_description or "").split())
+    if not desc:
+        return None
+    film = bool(FILM_WORDS.search(desc))
+    series = bool(SERIES_WORDS.search(desc))
+    if media_type == "tv_series" and film and not series:
+        return (f"the page's short description {desc!r} names a film and no series; the "
+                "candidate is a TV series")
+    if media_type == "movie" and series and not film:
+        return (f"the page's short description {desc!r} names a series and no film; the "
+                "candidate is a movie")
+    return None
