  "text:1100000002:1": {
   "parse": {
    "title": "Nizhal Veedu",
    "pageid": 0,
    "revid": 1100000002,
    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Plot\">Plot</h2></div><p>A young mechanic in a fictional Chennai suburb discovers that the abandoned house next door hides a stolen fortune, and he is drawn into a feud between two rival families who both claim it.<sup class=\"reference\">[2]</sup></p></div>"
   }
  },
