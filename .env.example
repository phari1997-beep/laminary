# Laminary environment variables. Copy to .env (gitignored) and fill in locally.
# Never commit real values. Where each value is stored per environment: docs/ENVIRONMENTS.md
# EXPO_PUBLIC_* values are bundled into the client app and are PUBLIC by design;
# never give an EXPO_PUBLIC_ name to anything secret.

# --- Runtime ---
# Which environment this process targets: dev | prod
LAMINARY_ENV=dev

# --- Supabase (one project per environment) ---
# Project API URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Public anon key; safe in the client only because Row Level Security is enforced
SUPABASE_ANON_KEY=
# SECRET. Bypasses RLS. Server-side only (pipelines, Edge Functions, CI jobs); never in the app
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Postgres connection string (includes the DB password); used for migrations and bulk loads
SUPABASE_DB_URL=
# Project ref (the <project-ref> in SUPABASE_URL); used by the Supabase CLI to link/deploy
SUPABASE_PROJECT_REF=
# SECRET. Personal access token for the Supabase CLI in CI (deploy migrations/functions)
SUPABASE_ACCESS_TOKEN=

# --- Metadata and summaries ---
# SECRET. TMDB API read access token (v4 bearer); commercial use needs a TMDB agreement (PLAN.md 8)
TMDB_API_KEY=
# Contact string sent as User-Agent to Wikipedia/Wikidata per Wikimedia policy, e.g. "LaminaryBot/0.1 (you@example.com)"
WIKIMEDIA_USER_AGENT=

# --- LLM and embeddings ---
# SECRET. Claude API key for annotation (Batch API for bulk runs)
ANTHROPIC_API_KEY=
# Embedding provider name; [OPEN] not chosen yet (data-pipeline to propose, Hari approves)
EMBEDDING_PROVIDER=
# SECRET. API key for the embedding provider above
EMBEDDING_API_KEY=

# --- Availability (vendor [OPEN], PLAN.md 5.3) ---
# Vendor identifier once chosen, e.g. watchmode | tmdb | streaming-availability
AVAILABILITY_VENDOR=
# SECRET. API key for the availability vendor
AVAILABILITY_API_KEY=

# --- Product analytics (PostHog) ---
# PostHog project API key (write-only ingestion key; public by design)
POSTHOG_KEY=
# PostHog ingestion host, e.g. https://us.i.posthog.com
POSTHOG_HOST=

# --- Expo app (public, bundled into the client) ---
# Same value as SUPABASE_URL for the target environment
EXPO_PUBLIC_SUPABASE_URL=
# Same value as SUPABASE_ANON_KEY for the target environment
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Same value as POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_KEY=
# Same value as POSTHOG_HOST
EXPO_PUBLIC_POSTHOG_HOST=
# SECRET. Expo access token so CI can run EAS builds (Phase 3; not used yet)
EXPO_TOKEN=

# --- Job monitoring / alerts ---
# SECRET-ish. Base ping URL for scheduled-job heartbeats (monitor service [OPEN]); a leaked URL lets anyone fake a heartbeat
JOB_HEARTBEAT_URL=
