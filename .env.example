# Laminary environment variables. Copy to .env (gitignored) and fill in locally.
# Never commit real values. Where each value lives per environment: docs/ENVIRONMENTS.md
# Phases 0-1 are local-first (DECISIONS 2026-09-26): .env points at the local Supabase
# stack from `supabase start`. From Phase 2 it points at the hosted dev project.
# EXPO_PUBLIC_* values are bundled into the client app and are PUBLIC by design;
# never give an EXPO_PUBLIC_ name to anything secret.

# --- Runtime ---
# Target environment: dev | prod. Leave empty; code defaults to dev
LAMINARY_ENV=

# --- Supabase ---
# API URL. Phases 0-1: local stack (value below). Phase 2+: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Public anon key; safe in the client only because Row Level Security is enforced. Local: from `supabase status`
SUPABASE_ANON_KEY=
# SECRET. Bypasses RLS. Server-side only (pipelines, Edge Functions, CI); never in the app. Local: from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=
# SECRET once hosted. Postgres connection string for migrations and bulk loads. Local: "DB URL" from `supabase status`
SUPABASE_DB_URL=
# Hosted project ref (the <project-ref> in SUPABASE_URL). Not needed until Phase 2
SUPABASE_PROJECT_REF=
# SECRET. Supabase CLI personal access token for deploys. Not needed until Phase 2
SUPABASE_ACCESS_TOKEN=

# --- Metadata and summaries ---
# SECRET. TMDB v3 API key or v4 read token; data-pipeline picks one
TMDB_API_KEY=
# Contact string sent as User-Agent to Wikipedia/Wikidata per Wikimedia policy, e.g. "LaminaryBot/0.1 (you@example.com)"
WIKIMEDIA_USER_AGENT=

# --- LLM and embeddings ---
# SECRET. Claude API key for annotation (Batch API for bulk runs)
ANTHROPIC_API_KEY=
# Embedding provider name; [OPEN] not chosen yet (data-pipeline to propose, Hari approves)
EMBEDDING_PROVIDER=
# SECRET. API key for the embedding provider above
EMBEDDING_API_KEY=

# --- Availability (vendor [OPEN], PLAN.md 5.3; Phase 2) ---
# Vendor identifier once chosen, e.g. watchmode | tmdb | streaming-availability
AVAILABILITY_VENDOR=
# SECRET. API key for the availability vendor
AVAILABILITY_API_KEY=

# --- Expo app (public, bundled into the client; Phase 3) ---
# Same value as SUPABASE_URL for the target environment (a phone can't reach 127.0.0.1; use your LAN IP locally)
EXPO_PUBLIC_SUPABASE_URL=
# Same value as SUPABASE_ANON_KEY for the target environment
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PostHog project API key (write-only ingestion key; public by design). Only the app uses PostHog
EXPO_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host, e.g. https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=
# SECRET. Expo access token so CI can run EAS builds (Phase 3; not used yet)
EXPO_TOKEN=

# --- Job monitoring / alerts (Phase 2) ---
# SECRET. Base ping URL for scheduled-job heartbeats (monitor service [OPEN]); a leaked URL lets anyone fake a heartbeat
JOB_HEARTBEAT_URL=
